  "homepage": "https://github.com/sleepingfreak94/resume-tracker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sleepingfreak94/resume-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/sleepingfreak94/resume-tracker/issues"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "security:repo": "node scripts/security-repo.mjs --history",
    "check": "npm run security:repo && npm run lint && npm run typecheck && npm test && npm run build",
    "codex:login": "codex login",
    "codex:status": "codex login status",
    "open-doc": "npx tsx scripts/open-doc.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@openai/codex": "0.149.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "googleapis": "^173.0.0",
    "next": "16.3.2",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "ignore-loader": "^0.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
