{
  "manifest_version": 3,
  "name": "Resume Tracker – LinkedIn Import & Auto-Fill",
  "version": "3.6.1",
  "description": "Import LinkedIn jobs and fill ATS forms, resumes, cover letters, and application questions.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "debugger"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*", "https://linkedin.com/jobs/*"],
      "js": ["content-linkedin-handoff.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
