{
  "manifest_version": 3,
  "name": "Resume Tracker – LinkedIn Import & Auto-Fill",
  "version": "3.1",
  "description": "Import LinkedIn jobs and fill ATS forms, resumes, cover letters, and application questions.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}
