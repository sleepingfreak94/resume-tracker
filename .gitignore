# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
client_secret*.json
credentials*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# google oauth tokens (local only)
/data/google-tokens.json

# local application data
/data/*.db
/data/*.db-shm
/data/*.db-wal
/data/*.db-journal
/data/*.sqlite
/data/*.sqlite3
/resumes/base-resume.md
/resumes/tailored/

# generated docx from open-doc script
/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local AI-agent configuration, memory, and runtime data
/.agents/
/.claude/
/.claude-flow/
/.codex/
/.swarm/
/.mcp.json
/ruvector.db
/agentdb.rvf
/agentdb.rvf.lock
/excalidraw.log
