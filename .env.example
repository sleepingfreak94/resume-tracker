# OpenAI API provider (optional; configured in Settings)
OPENAI_API_KEY=

# Cursor provider (optional)
CURSOR_API_KEY=

# Codex uses `npm run codex:login` and requires ChatGPT subscription auth.
# No Codex or OpenAI API key is passed to Codex subprocesses.

# Optional hardening: Chrome extension ID shown on chrome://extensions
# When set, API CORS is limited to this exact extension.
RESUME_TRACKER_EXTENSION_ID=

# Google Drive upload (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: upload resumes into this Drive folder ID
# GOOGLE_DRIVE_FOLDER_ID=
